{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marcus.local/schemas/object.schema.json",
  "title": "Marcus CAD canonical object",
  "type": "object",
  "required": ["id", "type", "name", "status", "revision", "sources", "dependencies", "validation"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["RECOVERED", "DERIVED", "CANONICAL", "INCOMPLETE", "CONFLICT"]},
    "revision": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "object"}
  },
  "additionalProperties": true
}
